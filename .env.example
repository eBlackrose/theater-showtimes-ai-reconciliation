# Copy to .env and fill in. Never commit real values.

# Postgres through the Supabase shared pooler, TRANSACTION mode (port 6543). Used by the app.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
# Same database, SESSION mode (port 5432). Used by migrate, seed and reset scripts. Local only.
MIGRATION_DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres"
# Any Postgres 15+ for integration tests. Each run creates and drops its own ronnie_test_* schema.
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Every table lives in this schema. Nothing outside it is touched.
DB_SCHEMA="ronnie_takehome"

# Server-side only. Without it the app still runs, in rule-based mode.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
AGENT_EFFORT="medium"
# Cap on AI analysis runs per UTC day (the demo URL is public).
AI_DAILY_RUN_LIMIT="200"
# Enables POST /api/admin/reset-demo.
DEMO_RESET_ENABLED="true"
